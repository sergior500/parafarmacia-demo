NEXT_PUBLIC_PHARMACY_NAME="Farmacia Picual"
NEXT_PUBLIC_PHARMACY_LEGAL_NAME=""
NEXT_PUBLIC_PHARMACY_ADDRESS="Sevilla (dirección pendiente)"
NEXT_PUBLIC_PHARMACY_PHONE="+34 000 000 000"
NEXT_PUBLIC_PHARMACY_EMAIL="hola@ejemplo.invalid"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ALLOW_INDEXING="false"

# Shopify (solo servidor: nunca usar el prefijo NEXT_PUBLIC_)
SHOPIFY_STORE_DOMAIN=""
# Flujo actual recomendado para una app propia instalada en la tienda.
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
# Compatibilidad temporal con integraciones que aún entreguen un token fijo.
SHOPIFY_ADMIN_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2026-07"
SHOPIFY_WEBHOOK_SECRET=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Panel interno (solo servidor). En producción la lista vacía bloquea todo acceso.
ADMIN_ALLOWED_EMAILS="administracion@farmacia.example"
# Alternativa estable por despliegue, separada por comas:
ADMIN_ALLOWED_USER_IDS=""

# Secreto aleatorio de al menos 32 caracteres para CSRF y huellas de seguridad.
# Debe configurarse como secreto del hosting y ser distinto en desarrollo/producción.
ADMIN_SECURITY_SECRET=""

# Roles de mínimo privilegio. Las listas heredadas anteriores equivalen a propietario.
ADMIN_OWNER_EMAILS=""
ADMIN_OWNER_USER_IDS=""
ADMIN_CATALOG_MANAGER_EMAILS=""
ADMIN_CATALOG_MANAGER_USER_IDS=""
ADMIN_OPERATIONS_MANAGER_EMAILS=""
ADMIN_OPERATIONS_MANAGER_USER_IDS=""
ADMIN_AUDITOR_EMAILS=""
ADMIN_AUDITOR_USER_IDS=""
